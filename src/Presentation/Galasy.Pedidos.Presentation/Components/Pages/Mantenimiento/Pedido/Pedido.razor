@page "/mantenimiento/pedido"
@rendermode InteractiveServer
@using Galasy.Pedidos.Business.Interfaces
@using Galasy.Pedidos.Entities
@using PedidoEntidad = Galasy.Pedidos.Entities.Pedido
@inject IPedidoService PedidoService
@inject IClienteService ClienteService
@inject IProductoService ProductoService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Pedidos</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
        <div>
            <MudText Typo="Typo.h4">Pedidos</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                Consulte y administre los pedidos registrados.
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AbrirCrear">
            Nuevo pedido
        </MudButton>
    </MudStack>

    <MudPaper Elevation="1" Class="pa-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h6">Listado de pedidos</MudText>
            <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">@(_pedidos.Count) registros</MudChip>
        </MudStack>

        @if (_cargando)
        {
            <MudProgressLinear Color="Color.Primary" Class="mb-2" />
        }

        <MudTable Items="_pedidos" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Cliente</MudTh>
                <MudTh>Total</MudTh>
                <MudTh>Adelanto</MudTh>
                <MudTh>Saldo</MudTh>
                <MudTh>Fecha</MudTh>
                <MudTh>Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="ID">@context.Id</MudTd>
                <MudTd DataLabel="Cliente">@(_clientes.FirstOrDefault(c => c.Id == context.IdCliente)?.RazonSocial ?? "-")</MudTd>
                <MudTd DataLabel="Total">S/. @context.TotalNeto.ToString("N2")</MudTd>
                <MudTd DataLabel="Adelanto">S/. @context.Adelanto.ToString("N2")</MudTd>
                <MudTd DataLabel="Saldo">S/. @(context.TotalNeto - context.Adelanto).ToString("N2")</MudTd>
                <MudTd DataLabel="Fecha">@context.FechaCreacion.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="Acciones">
                    @if (_pendienteEliminarId == context.Id)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Check"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       aria-label="Confirmar eliminacion"
                                       OnClick="@(() => EliminarPedido(context.Id))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="Size.Small"
                                       aria-label="Cancelar"
                                       OnClick="@(() => _pendienteEliminarId = 0)" />
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       aria-label="Editar"
                                       OnClick="@(() => AbrirEditar(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       aria-label="Eliminar"
                                       OnClick="@(() => _pendienteEliminarId = context.Id)" />
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Class="pa-8">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart"
                             Color="Color.Default"
                             Size="Size.Large" />
                    <MudText Typo="Typo.h6" Class="mt-3">Aun no hay pedidos registrados</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Registre el primer pedido para comenzar.
                    </MudText>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Class="mt-3"
                               OnClick="AbrirCrear">
                        Nuevo pedido
                    </MudButton>
                </MudStack>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private List<PedidoEntidad> _pedidos = [];
    private List<Cliente> _clientes = [];
    private List<Producto> _productos = [];
    private int _pendienteEliminarId;
    private bool _cargando;

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Mantenimiento", "/mantenimiento"),
        new("Pedidos", "/mantenimiento/pedido", disabled: true)
    ];

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        _cargando = true;
        try
        {
            var pedidosResult = await PedidoService.GetAllPedidos();
            _pedidos = pedidosResult.Success ? [.. pedidosResult.Data ?? []] : [];

            var clientesResult = await ClienteService.GetAllClientes();
            _clientes = clientesResult.Success ? [.. clientesResult.Data ?? []] : [];

            var productosResult = await ProductoService.GetAllProductos();
            _productos = productosResult.Success ? [.. productosResult.Data ?? []] : [];
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task AbrirCrear()
    {
        var parameters = new DialogParameters<FormPedido>
        {
            { x => x.Clientes, _clientes },
            { x => x.Productos, _productos }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<FormPedido>("Nuevo pedido", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await CargarDatosAsync();
            Snackbar.Add("Pedido registrado correctamente", Severity.Success);
        }
    }

    private async Task AbrirEditar(PedidoEntidad pedido)
    {
        var parameters = new DialogParameters<FormPedido>
        {
            { x => x.PedidoId, pedido.Id },
            { x => x.IdCliente, pedido.IdCliente },
            { x => x.Adelanto, pedido.Adelanto },
            { x => x.ExistentesDetalles, pedido.PedidoDetalles.Select(d => new FormPedido.DetalleExistente
            {
                IdProducto = d.IdProducto,
                Cantidad = d.Cantidad,
                PrecioUnitario = d.PrecioUnitario
            }).ToList() },
            { x => x.Clientes, _clientes },
            { x => x.Productos, _productos },
            { x => x.EsEdicion, true }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<FormPedido>("Editar pedido", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await CargarDatosAsync();
            Snackbar.Add("Pedido actualizado correctamente", Severity.Success);
        }
    }

    private async Task EliminarPedido(int id)
    {
        var response = await PedidoService.DeletePedido(id);
        _pendienteEliminarId = 0;

        if (response.Success)
        {
            Snackbar.Add(response.Message ?? "Eliminado", Severity.Success);
            await CargarDatosAsync();
        }
        else
        {
            Snackbar.Add(response.ErrorMessage ?? response.Message ?? "Ocurrio un error", Severity.Error);
        }
    }
}
