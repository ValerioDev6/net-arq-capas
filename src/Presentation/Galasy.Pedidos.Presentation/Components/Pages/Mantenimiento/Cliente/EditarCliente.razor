@page "/mantenimiento/cliente/editar/{id:int}"
@rendermode InteractiveServer
@using Galasy.Pedidos.Business.Interfaces
@inject IClienteService ClienteService

<PageTitle>Editar cliente</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4 client-form">
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />

    <MudPaper Elevation="1" Class="pa-4 pa-sm-6 client-form-card">
        <MudText Typo="Typo.h6">Editar cliente</MudText>

        @if (_cargando)
        {
            <MudProgressLinear Color="Color.Primary" />
        }
        else if (_cliente is not null)
        {
            <FormCliente Model="_cliente"
                         SubmitText="Guardar cambios"
                         OnValidSubmit="GuardarCliente" />

            @if (!string.IsNullOrWhiteSpace(_mensaje))
            {
                <MudAlert Severity="@_alertaSeverity" Class="mt-4">@_mensaje</MudAlert>
            }
        }
        else
        {
            <MudAlert Severity="Severity.Error">Cliente no encontrado.</MudAlert>
            <MudButton Href="/mantenimiento/cliente"
                       Variant="Variant.Outlined"
                       Class="mt-4">
                Volver al listado
            </MudButton>
        }
    </MudPaper>
</MudContainer>

@code {
    private ClienteRequest? _cliente;
    private string? _mensaje;
    private Severity _alertaSeverity = Severity.Success;
    private bool _cargando = true;

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Mantenimiento", "/mantenimiento"),
        new("Clientes", "/mantenimiento/cliente"),
        new("Editar", null, true)
    ];

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _cargando = true;
        try
        {
            var response = await ClienteService.GetClienteById(Id);
            if (response.Success && response.Data is not null)
            {
                _cliente = new ClienteRequest
                {
                    RazonSocial = response.Data.RazonSocial,
                    TipoDocumento = response.Data.TipoDocumento,
                    NumeroDocumento = response.Data.NumeroDocumento,
                    Contacto = response.Data.Contacto,
                    Direccion = response.Data.Direccion,
                    CorreoElectronico = response.Data.CorreoElectronico,
                    Celular = response.Data.Celular,
                    IdRubroMae = response.Data.IdRubroMae
                };
            }
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task GuardarCliente(ClienteRequest cliente)
    {
        var response = await ClienteService.UpdateCliente(Id, cliente);
        _alertaSeverity = response.Success ? Severity.Success : Severity.Error;
        _mensaje = response.Success ? response.Message : response.ErrorMessage ?? response.Message;
    }
}